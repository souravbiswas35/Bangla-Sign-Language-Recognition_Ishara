# Production Backend URL (deployed on Render, Railway, etc.)
# If deploying on Vercel, add this in Vercel Project Settings > Environment Variables:
VITE_BACKEND_URL=https://your-backend-app.onrender.com

# Optional: Explicit WebSocket URL (only needed if different from VITE_BACKEND_URL host)
# VITE_WS_URL=wss://your-backend-app.onrender.com/ws/predict
